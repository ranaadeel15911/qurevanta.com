# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables (then redeploy).
# All are optional: the site works without them.

# Contact/audit form → Cloud Firestore. Defaults to the qurevanta Firebase project; set only to override.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=

# Email alert for each form submission (free key from web3forms.com, created with info@qurevanta.com)
VITE_WEB3FORMS_KEY=

# Google Search Console "HTML tag" verification: only the content="…" value
VITE_GOOGLE_SITE_VERIFICATION=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
# Adds the google-adsense-account meta tag and generates /ads.txt at build time.
VITE_ADSENSE_CLIENT=
# Ad unit IDs (AdSense → Ads → By ad unit → Display ads). Ads show on articles only.
VITE_ADSENSE_SLOT_IN_ARTICLE=
VITE_ADSENSE_SLOT_END_OF_ARTICLE=
