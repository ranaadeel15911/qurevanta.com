rules_version = '2';
// Website form submissions: anyone may create a lead with the expected fields; nobody can read,
// update, or delete leads from the browser. Read leads in the Firebase console.
// Deploy with: firebase deploy --only firestore:rules  (or paste into Firestore > Rules in the console)
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['source', 'name', 'email', 'phone', 'practice', 'specialty', 'service', 'message', 'createdAt'])
        && request.resource.data.source in ['audit', 'contact']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\s]+@[^@\s]+\.[^@\s]+$') && request.resource.data.email.size() <= 200
        && request.resource.data.practice is string && request.resource.data.practice.size() > 0 && request.resource.data.practice.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.specialty is string && request.resource.data.specialty.size() <= 120
        && request.resource.data.service is string && request.resource.data.service.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(10, 'm')
        && request.resource.data.createdAt < request.time + duration.value(10, 'm');
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
