rules_version = '2';
// Website form submissions: anyone may create a lead with the expected fields; nobody can read,
// update, or delete leads from the browser. Read leads in the Firebase console.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
// Note: fields are read with data['name'] syntax because "service" is a reserved word in rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function text(d, field, minLen, maxLen) {
      return d[field] is string && d[field].size() >= minLen && d[field].size() <= maxLen;
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['source', 'name', 'email', 'phone', 'practice', 'specialty', 'service', 'message', 'createdAt'])
        && request.resource.data['source'] in ['audit', 'contact']
        && text(request.resource.data, 'name', 1, 120)
        && text(request.resource.data, 'email', 3, 200)
        && request.resource.data['email'].matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && text(request.resource.data, 'practice', 1, 200)
        && text(request.resource.data, 'phone', 0, 40)
        && text(request.resource.data, 'specialty', 0, 120)
        && text(request.resource.data, 'service', 0, 200)
        && text(request.resource.data, 'message', 0, 2000)
        && request.resource.data['createdAt'] is timestamp
        && request.resource.data['createdAt'] > request.time - duration.value(10, 'm')
        && request.resource.data['createdAt'] < request.time + duration.value(10, 'm');
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
